# Chaves de API para o Assistente Pessoal Desktop V2
# Renomeie este arquivo para .env e insira as suas chaves abaixo.

# API Key do OpenRouter (Opcional, usada para fallback de LLMs em nuvem)
OPENROUTER_API_KEY=sua_chave_openrouter_aqui

# API Key do Groq (Opcional, muito rápida)
GROQ_API_KEY=sua_chave_groq_aqui

# API Key do Cerebras (Opcional, baixíssima latência)
CEREBRAS_API_KEY=sua_chave_cerebras_aqui

# API Key do DeepSeek (Opcional)
DEEPSEEK_API_KEY=sua_chave_deepseek_aqui

# API Key do SiliconFlow (Opcional)
SILICONFLOW_API_KEY=sua_chave_siliconflow_aqui

# API Key da Nvidia NIM (Opcional)
NVIDIA_API_KEY=sua_chave_nvidia_aqui

# Configuração do Ollama (Padrão: ollama se rodando localmente)
OLLAMA_API_KEY=ollama
